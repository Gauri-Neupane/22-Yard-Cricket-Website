{%- style -%}
  #PromoRow-{{ section.id }} {
    display: grid;
    grid-template-columns: 1fr;
    padding-top: {{ section.settings.padding_top }}px;
    padding-bottom: {{ section.settings.padding_bottom }}px;
  }

  @media screen and (min-width: 750px) {
    #PromoRow-{{ section.id }} {
      grid-template-columns: repeat({{ section.blocks.size }}, 1fr);
      gap: 1.5rem;
    }

    #PromoRow-{{ section.id }} .promo-row__item {
      height: {{ section.settings.desktop_height }}px;
    }

    #PromoRow-{{ section.id }} .promo-row__item img {
      height: 100%;
      object-fit: cover;
    }
  }

  #PromoRow-{{ section.id }} .promo-row__item {
    position: relative;
    overflow: hidden;
  }

  #PromoRow-{{ section.id }} .promo-row__item img {
    display: block;
    width: 100%;
    height: auto;
  }

  #PromoRow-{{ section.id }} .promo-row__content {
    position: absolute;
    display: flex;
    padding: 2rem;
    inset: 0;
  }

  #PromoRow-{{ section.id }} .promo-row__content--top-left { align-items: flex-start; justify-content: flex-start; }
  #PromoRow-{{ section.id }} .promo-row__content--top-right { align-items: flex-start; justify-content: flex-end; }
  #PromoRow-{{ section.id }} .promo-row__content--middle-left { align-items: center; justify-content: flex-start; }
  #PromoRow-{{ section.id }} .promo-row__content--middle-right { align-items: center; justify-content: flex-end; }
  #PromoRow-{{ section.id }} .promo-row__content--bottom-left { align-items: flex-end; justify-content: flex-start; }
  #PromoRow-{{ section.id }} .promo-row__content--bottom-right { align-items: flex-end; justify-content: flex-end; }
  #PromoRow-{{ section.id }} .promo-row__content--bottom-center { align-items: flex-end; justify-content: center; }

  {%- for block in section.blocks -%}
    #PromoRow-{{ section.id }} [data-block-id="{{ block.id }}"] img {
      object-position: {{ block.settings.image_position | replace: '-', ' ' }};
    }
  {%- endfor -%}
{%- endstyle -%}

<div id="PromoRow-{{ section.id }}" class="promo-row page-width{% if settings.animations_reveal_on_scroll %} scroll-trigger animate--fade-in{% endif %}">
  {%- for block in section.blocks -%}
    <div class="promo-row__item" data-block-id="{{ block.id }}" {{ block.shopify_attributes }}>
      {%- if block.settings.image != blank -%}
        {{
          block.settings.image
          | image_url: width: 1600
          | image_tag:
            loading: 'lazy',
            sizes: '(min-width: 750px) 50vw, 100vw',
            widths: '375, 550, 750, 1100, 1500, 1600'
        }}
      {%- else -%}
        {{ 'hero-apparel-1' | placeholder_svg_tag: 'placeholder-svg' }}
      {%- endif -%}
      {%- if block.settings.button_label != blank -%}
        <div class="promo-row__content promo-row__content--{{ block.settings.content_position }}">
          <a
            {% if block.settings.button_link == blank %}
              role="link" aria-disabled="true"
            {% else %}
              href="{{ block.settings.button_link }}"
            {% endif %}
            class="button{% if block.settings.button_style_secondary %} button--secondary{% else %} button--primary{% endif %}"
          >
            {{ block.settings.button_label }}
          </a>
        </div>
      {%- endif -%}
    </div>
  {%- endfor -%}
</div>

{% schema %}
{
  "name": "Promo row",
  "tag": "section",
  "class": "section",
  "max_blocks": 3,
  "settings": [
    {
      "type": "range",
      "id": "desktop_height",
      "min": 200,
      "max": 600,
      "step": 20,
      "unit": "px",
      "label": "Image height on desktop",
      "default": 400
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "Top padding",
      "default": 0
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "Bottom padding",
      "default": 0
    }
  ],
  "blocks": [
    {
      "type": "banner",
      "name": "Banner",
      "settings": [
        {
          "type": "image_picker",
          "id": "image",
          "label": "Image"
        },
        {
          "type": "select",
          "id": "image_position",
          "label": "Image crop position (desktop)",
          "info": "Controls which part of the image stays visible when it's cropped to match the shared row height.",
          "options": [
            { "value": "center-center", "label": "Center" },
            { "value": "left-center", "label": "Left" },
            { "value": "right-center", "label": "Right" },
            { "value": "center-top", "label": "Top" },
            { "value": "center-bottom", "label": "Bottom" },
            { "value": "left-bottom", "label": "Bottom left" },
            { "value": "right-bottom", "label": "Bottom right" },
            { "value": "left-top", "label": "Top left" },
            { "value": "right-top", "label": "Top right" }
          ],
          "default": "center-center"
        },
        {
          "type": "text",
          "id": "button_label",
          "label": "Button label"
        },
        {
          "type": "url",
          "id": "button_link",
          "label": "Button link"
        },
        {
          "type": "checkbox",
          "id": "button_style_secondary",
          "label": "Use outline button style",
          "default": false
        },
        {
          "type": "select",
          "id": "content_position",
          "label": "Button position",
          "options": [
            { "value": "top-left", "label": "Top left" },
            { "value": "top-right", "label": "Top right" },
            { "value": "middle-left", "label": "Middle left" },
            { "value": "middle-right", "label": "Middle right" },
            { "value": "bottom-left", "label": "Bottom left" },
            { "value": "bottom-right", "label": "Bottom right" },
            { "value": "bottom-center", "label": "Bottom center" }
          ],
          "default": "bottom-left"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Promo row",
      "blocks": [
        { "type": "banner" },
        { "type": "banner" }
      ]
    }
  ]
}
{% endschema %}
